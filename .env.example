# OpsPilot control plane
OPSPILOT_ENV=local
OPSPILOT_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot

# HolmesGPT (pinned; never use :latest)
HOLMES_VERSION=0.39.0
HOLMES_IMAGE=robustadev/holmes:0.39.0
HOLMES_BASE_URL=http://localhost:5050
HOLMES_MODEL=azure/gpt-4o
HOLMES_MODEL_NAME=azure-default

# Azure OpenAI (default provider). Do not commit real values.
# Use the resource root only, e.g. https://<resource>.openai.azure.com/
# Do not include /openai/v1 or /openai/deployments/...
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Optional contrast providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Observability backends (Phase 1+)
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
